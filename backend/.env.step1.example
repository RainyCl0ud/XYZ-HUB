# XYZ Hub - Step 1 environment reference
#
# Copy only the values you need into backend/.env.
# Never commit backend/.env or real credentials.

# =========================================================
# LOCAL / SHARED
# =========================================================

FRONTEND_URL=http://localhost:5173

# Required for hashing emailed 2FA codes.
# Use a long random secret in every real environment.
TWO_FACTOR_CODE_SECRET=replace-with-a-long-random-local-secret

# =========================================================
# EMAIL DELIVERY
# =========================================================

# LOCAL:
# Use console delivery during normal local development.
EMAIL_DELIVERY_MODE=console

# Optional per-flow overrides.
# INVITE_DELIVERY_MODE=console
# PASSWORD_RESET_DELIVERY_MODE=console
# TWO_FACTOR_DELIVERY_MODE=console

# =========================================================
# GOOGLE WORKSPACE GMAIL API
# =========================================================
#
# STAGING / PRODUCTION:
#
# EMAIL_DELIVERY_MODE=gmail_api
# INVITE_DELIVERY_MODE=gmail_api
# PASSWORD_RESET_DELIVERY_MODE=gmail_api
# TWO_FACTOR_DELIVERY_MODE=gmail_api
#
# EMAIL_FROM=XYZ Management <no-reply@xyzofm.xyz>
# GOOGLE_WORKSPACE_USER=dim@xyzofm.xyz
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
#
# Never commit real Google credentials.

AUDIT_STORE_MODE=file
# AUDIT_FILE_PATH=C:\path\to\xyz-audit-events.jsonl
ALLOW_FILE_AUDIT_IN_PRODUCTION=false
