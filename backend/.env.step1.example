# XYZ Hub - Step 1 environment reference
#
# Copy only the values you need into backend/.env.
# Never commit backend/.env or real credentials.

# =========================================================
# LOCAL / SHARED
# =========================================================

FRONTEND_URL=http://localhost:5173

# Required for hashing emailed 2FA codes.
# Use a long random secret in every real environment.
TWO_FACTOR_CODE_SECRET=replace-with-a-long-random-local-secret

# =========================================================
# EMAIL DELIVERY
# =========================================================
#
# LOCAL:
# Keep the shared mode on console. Invite links, password-reset
# links and 2FA codes will be printed only in the backend terminal.
#
# GOOGLE WORKSPACE LATER:
# Change EMAIL_DELIVERY_MODE to smtp and configure the SMTP values
# after XYZ grants the required Workspace access.
#
# The three feature-specific variables are OPTIONAL OVERRIDES.
# Leave them commented unless a specific flow intentionally needs
# a different delivery mode. If one is set to "console", it takes
# precedence over EMAIL_DELIVERY_MODE for that flow.

EMAIL_DELIVERY_MODE=console

# INVITE_DELIVERY_MODE=console
# PASSWORD_RESET_DELIVERY_MODE=console
# TWO_FACTOR_DELIVERY_MODE=console

# SMTP settings are intentionally inactive during local console mode.
# The exact Google Workspace relay/auth values will be filled in only
# after the Workspace configuration is confirmed.
#
# SMTP_HOST=smtp-relay.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=XYZ Hub <no-reply@xyzofm.xyz>
# SMTP_USER=
# SMTP_PASSWORD=

# =========================================================
# AUDIT
# =========================================================
#
# Local Step 1 uses an append-only JSONL development adapter
# outside PostgreSQL. Production must use durable external
# append-only storage.

AUDIT_STORE_MODE=file
# AUDIT_FILE_PATH=C:\path\to\xyz-audit-events.jsonl
ALLOW_FILE_AUDIT_IN_PRODUCTION=false
