generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChatterStatus {
  ACTIVE
  INACTIVE
}

enum IncidentStatus {
  OPEN
  RESOLVED
  VOIDED
}

model Chatter {
  id        String        @id @default(cuid())
  name      String
  status    ChatterStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  incidents Incident[]

  @@index([status])
}

model Rule {
  id         String    @id @default(cuid())
  isActive   Boolean   @default(true)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  versions RuleVersion[]

  @@index([isActive])
}

model SeverityOption {
  id          String    @id @default(cuid())
  name        String
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ruleVersions RuleVersion[]

  @@index([isActive])
  @@index([sortOrder])
}

model WeightOption {
  id          String    @id @default(cuid())
  name        String
  value       Int?
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ruleVersions RuleVersion[]

  @@index([isActive])
  @@index([sortOrder])
}

model RuleVersion {
  id            String @id @default(cuid())
  ruleId        String
  versionNumber Int

  title      String
  definition String

  severityOptionId String?
  weightOptionId   String?

  // Historical snapshot of the selected configuration
  severityNameSnapshot String?
  weightNameSnapshot   String?
  weightValueSnapshot  Int?

  createdAt DateTime @default(now())

  rule           Rule            @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  severityOption SeverityOption? @relation(fields: [severityOptionId], references: [id], onDelete: Restrict)
  weightOption   WeightOption?   @relation(fields: [weightOptionId], references: [id], onDelete: Restrict)

  incidents Incident[]

  @@unique([ruleId, versionNumber])
  @@index([ruleId])
  @@index([severityOptionId])
  @@index([weightOptionId])
}

model Incident {
  id            String @id @default(cuid())
  chatterId     String
  ruleVersionId String

  // Historical snapshot of the rule at the time the incident was logged
  ruleTitleSnapshot      String
  ruleDefinitionSnapshot String
  severityNameSnapshot   String?
  weightNameSnapshot     String?
  weightValueSnapshot    Int?

  occurredAt  DateTime @default(now())
  details     String
  evidenceUrl String?

  status IncidentStatus @default(OPEN)

  resolutionNotes String?
  resolvedAt      DateTime?

  voidReason String?
  voidedAt   DateTime?

  chatter     Chatter     @relation(fields: [chatterId], references: [id], onDelete: Restrict)
  ruleVersion RuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)

  @@index([chatterId])
  @@index([ruleVersionId])
  @@index([status])
  @@index([occurredAt])
}
