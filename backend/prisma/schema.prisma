generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChatterStatus {
  ACTIVE
  INACTIVE
}

enum IncidentStatus {
  OPEN
  RESOLVED
  VOIDED
}

enum UserStatus {
  PENDING_SETUP
  ACTIVE
  DEACTIVATED
}

enum RoleDataScope {
  ALL
  SELF_AND_TEAM
  SELF
}

enum TwoFactorMethodType {
  EMAIL
  AUTHENTICATOR
}

/**
 * =========================================================
 * LOGIN GATE — USERS
 * =========================================================
 */

model User {
  id String @id @default(cuid())

  name  String
  email String @unique

  passwordHash String?

  status UserStatus @default(PENDING_SETUP)

  emailVerifiedAt DateTime?
  lastSignInAt    DateTime?
  deactivatedAt   DateTime?

  avatarImage     Bytes?
  avatarMimeType  String?
  avatarUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleMemberships     UserRole[] @relation("UserRoleMember")
  roleAssignmentsMade UserRole[] @relation("UserRoleAssigner")

  teamGroupId String?
  teamGroup   TeamGroup? @relation("TeamGroupMembers", fields: [teamGroupId], references: [id], onDelete: SetNull)

  modelAssignments     UserModelAssignment[] @relation("UserModelMember")
  modelAssignmentsMade UserModelAssignment[] @relation("UserModelAssigner")

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  twoFactorMethods    UserTwoFactorMethod[]
  twoFactorChallenges TwoFactorChallenge[]

  invites        Invite[] @relation("Invitee")
  invitesCreated Invite[] @relation("InviteCreator")

  chatterProfile Chatter?
  creatorProfile AgencyModel? @relation("CreatorAccount")
  chatMessages ChatMessage[]
  standingChats ChatStandingConversation[]
  chatQuarantines ChatQuarantine[]

  chatReactions ChatReaction[]
  chatPinnedMessages ChatMessage[] @relation("ChatPinnedBy")
  chatDeletedMessages ChatMessage[] @relation("ChatDeletedBy")

  clockShifts ClockShift[]
  clockAlertReads ClockAlertRead[]
  clockCorrections ClockCorrection[] @relation("ClockCorrectionSubject")
  clockCorrectionReviews ClockCorrection[] @relation("ClockCorrectionReviewer")

  strikesReceived Strike[] @relation("StrikeTarget")
  strikesIssued   Strike[] @relation("StrikeIssuer")
  strikesVoided   Strike[] @relation("StrikeVoider")

  @@index([status])
  @@index([teamGroupId])
  @@index([createdAt])
}

/**
 * =========================================================
 * TEAM MANAGEMENT — ORGANIZATION GROUPS
 * =========================================================
 * Groups form the reporting hierarchy used by the
 * Self + subordinates data scope. Every group except
 * the agency root has a parent.
 */

model TeamGroup {
  id String @id @default(cuid())

  name String

  parentId String?
  isRoot   Boolean @default(false)
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   TeamGroup?  @relation("TeamGroupHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children TeamGroup[] @relation("TeamGroupHierarchy")

  members User[] @relation("TeamGroupMembers")

  @@index([parentId])
  @@index([name])
  @@index([isRoot])
}

/**
 * =========================================================
 * LOGIN GATE — ROLES
 * =========================================================
 */

model Role {
  id String @id @default(cuid())

  /**
   * Permanent internal identifier for default roles.
   * Examples:
   * OWNER
   * OPS_MANAGER
   * MANAGER
   * Custom roles use null.
   */
  systemKey String? @unique

  name        String  @unique
  description String?

  rank      Int?
  dataScope RoleDataScope

  landingPath String?

  isSystem Boolean @default(false)

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
  chatGrants ChatRoleGrant[]

  @@index([rank])
  @@index([isSystem])
  @@index([archivedAt])
}

model UserRole {
  id String @id @default(cuid())

  userId String
  roleId String

  assignedByUserId String?

  assignedAt DateTime @default(now())

  user       User  @relation("UserRoleMember", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("UserRoleAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([assignedByUserId])
}

/**
 * =========================================================
 * LOGIN GATE — PERMISSIONS
 * =========================================================
 */

model Permission {
  id String @id @default(cuid())

  key String @unique

  name        String
  description String?

  pageKey     String
  categoryKey String?
  actionKey   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([pageKey])
  @@index([categoryKey])
  @@index([actionKey])
}

model RolePermission {
  id String @id @default(cuid())

  roleId       String
  permissionId String

  createdAt DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

/**
 * =========================================================
 * LOGIN GATE — MODELS
 * =========================================================
 */

model AgencyModel {
  id String @id @default(cuid())

  name String @unique

  creatorUserId String? @unique
  creatorUser User? @relation("CreatorAccount", fields: [creatorUserId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments UserModelAssignment[]
  incidents   Incident[]
  chatArea ChatArea?
  standingChats ChatStandingConversation[]

  @@index([isActive])
}

model UserModelAssignment {
  id String @id @default(cuid())

  userId  String
  modelId String

  assignedByUserId String?

  assignedAt DateTime @default(now())

  user       User        @relation("UserModelMember", fields: [userId], references: [id], onDelete: Cascade)
  model      AgencyModel @relation(fields: [modelId], references: [id], onDelete: Restrict)
  assignedBy User?       @relation("UserModelAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  chatGrants ChatPersonGrant[]

  @@unique([userId, modelId])
  @@index([userId])
  @@index([modelId])
  @@index([assignedByUserId])
}

/**
 * =========================================================
 * LOGIN GATE — INVITES
 * =========================================================
 */

model Invite {
  id String @id @default(cuid())

  userId String

  tokenHash String @unique

  createdByUserId String?

  sentAt    DateTime @default(now())
  expiresAt DateTime

  acceptedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  user      User  @relation("Invitee", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("InviteCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdByUserId])
  @@index([expiresAt])
  @@index([acceptedAt])
  @@index([revokedAt])
}

/**
 * =========================================================
 * LOGIN GATE — SESSIONS
 * =========================================================
 */

model Session {
  id String @id @default(cuid())

  userId String

  tokenHash String @unique

  userAgent String?
  ipAddress String?

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

/**
 * =========================================================
 * LOGIN GATE — PASSWORD RESET
 * =========================================================
 */

model PasswordResetToken {
  id String @id @default(cuid())

  userId String

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

/**
 * =========================================================
 * LOGIN GATE — TWO-FACTOR AUTHENTICATION
 * =========================================================
 */

model UserTwoFactorMethod {
  id String @id @default(cuid())

  userId String

  type TwoFactorMethodType

  isEnabled Boolean @default(true)

  verifiedAt DateTime?

  /**
   * Reserved for future authenticator application support.
   */
  secretEncrypted String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@index([type])
}

model TwoFactorChallenge {
  id String @id @default(cuid())

  userId String

  methodType TwoFactorMethodType

  codeHash String

  expiresAt DateTime

  consumedAt DateTime?

  failedAttempts Int @default(0)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
}

/**
 * =========================================================
 * EXISTING QA / STRIKE SYSTEM
 * =========================================================
 */

model Chatter {
  id String @id @default(cuid())

  /**
   * Temporary bridge between the existing QA chatter record
   * and the Login Gate user identity.
   */
  userId String? @unique

  name   String
  status ChatterStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  incidents Incident[]

  @@index([status])
}

model Rule {
  id String @id @default(cuid())

  isActive   Boolean   @default(true)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions RuleVersion[]

  @@index([isActive])
}

model SeverityOption {
  id String @id @default(cuid())

  name        String
  description String?

  sortOrder Int @default(0)

  isActive   Boolean   @default(true)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ruleVersions RuleVersion[]

  @@index([isActive])
  @@index([sortOrder])
}

model WeightOption {
  id String @id @default(cuid())

  name        String
  value       Int?
  description String?

  sortOrder Int @default(0)

  isActive   Boolean   @default(true)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ruleVersions RuleVersion[]

  @@index([isActive])
  @@index([sortOrder])
}

model RuleVersion {
  id String @id @default(cuid())

  ruleId        String
  versionNumber Int

  title      String
  definition String

  severityOptionId String?
  weightOptionId   String?

  severityNameSnapshot String?
  weightNameSnapshot   String?
  weightValueSnapshot  Int?

  createdAt DateTime @default(now())

  rule           Rule            @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  severityOption SeverityOption? @relation(fields: [severityOptionId], references: [id], onDelete: Restrict)
  weightOption   WeightOption?   @relation(fields: [weightOptionId], references: [id], onDelete: Restrict)

  incidents Incident[]

  @@unique([ruleId, versionNumber])
  @@index([ruleId])
  @@index([severityOptionId])
  @@index([weightOptionId])
}

model Incident {
  id String @id @default(cuid())

  chatterId     String
  ruleVersionId String

  /**
   * Optional during the QA → Login Gate transition.
   * New incidents will later require model context.
   */
  modelId String?

  ruleTitleSnapshot      String
  ruleDefinitionSnapshot String
  severityNameSnapshot   String?
  weightNameSnapshot     String?
  weightValueSnapshot    Int?

  occurredAt DateTime @default(now())

  details     String
  evidenceUrl String?

  status IncidentStatus @default(OPEN)

  resolutionNotes String?
  resolvedAt      DateTime?

  voidReason String?
  voidedAt   DateTime?

  chatter     Chatter      @relation(fields: [chatterId], references: [id], onDelete: Restrict)
  ruleVersion RuleVersion  @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  agencyModel AgencyModel? @relation(fields: [modelId], references: [id], onDelete: Restrict)

  @@index([chatterId])
  @@index([ruleVersionId])
  @@index([modelId])
  @@index([status])
  @@index([occurredAt])
}

/**
 * =========================================================
 * STRIKE LADDER CONFIGURATION
 * =========================================================
 */

model StrikeLadderVersion {
  id String @id @default(cuid())

  versionNumber Int @unique

  durationDays Int @default(30)

  isCurrent Boolean @default(false)

  createdAt DateTime @default(now())

  steps   StrikeLadderStep[]
  strikes Strike[]

  @@index([isCurrent])
  @@index([createdAt])
}

model StrikeLadderStep {
  id String @id @default(cuid())

  ladderVersionId String

  minActiveStrikes Int

  standingLabel String

  deductionPercent Float

  ladderVersion StrikeLadderVersion @relation(fields: [ladderVersionId], references: [id], onDelete: Restrict)

  @@unique([ladderVersionId, minActiveStrikes])
  @@index([ladderVersionId])
  @@index([minActiveStrikes])
}

/**
 * =========================================================
 * STRIKE MANAGEMENT
 * =========================================================
 * Strikes are deliberate disciplinary actions.
 * They are intentionally independent from QA Incidents.
 * Logging a QA Incident does not create or imply a Strike.
 */

model StrikeReason {
  id String @id @default(cuid())

  name        String  @unique
  description String?

  sortOrder Int @default(0)

  isActive   Boolean   @default(true)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  strikes Strike[]

  @@index([isActive])
  @@index([sortOrder])
}

model Strike {
  id String @id @default(cuid())

  /**
   * The employee receiving the Strike.
   * Nullable by design: if a person is permanently deleted
   * later, the historical disciplinary record survives using
   * the identity snapshots below.
   */
  userId String?

  userNameSnapshot  String
  userEmailSnapshot String

  /**
   * Management user who issued the Strike.
   * Also nullable for the same historical-integrity reason.
   */
  issuedByUserId String?

  issuedByNameSnapshot String

  reasonId String

  reasonNameSnapshot        String
  reasonDescriptionSnapshot String?

  details     String
  evidenceUrl String?

  /**
   * Optional QA Incident that prompted this disciplinary action.
   * This is intentionally a traceability reference only.
   * A QA Incident never automatically becomes or counts as a Strike.
   */
  sourceIncidentId String? @unique

  issuedAt  DateTime @default(now())
  expiresAt DateTime

  /**
   * Policy version in effect when the Strike was issued.
   */
  ladderVersionId String

  /**
   * Consequence snapshot at issuance time.
   * Current standing is still derived from currently-active
   * Strike records. These values answer the historical question:
   * "What did this Strike produce when it was issued?"
   */
  activeStrikeCountAfterIssue Int
  standingLabelSnapshot       String
  deductionPercentSnapshot    Float

  /**
   * Strike status is derived:
   * voidedAt != null  -> VOIDED
   * expiresAt <= now  -> EXPIRED
   * otherwise         -> ACTIVE
   */
  voidedAt DateTime?

  voidedByUserId String?

  voidedByNameSnapshot String?

  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation("StrikeTarget", fields: [userId], references: [id], onDelete: SetNull)

  issuedBy User? @relation("StrikeIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  voidedBy User? @relation("StrikeVoider", fields: [voidedByUserId], references: [id], onDelete: SetNull)

  reason StrikeReason @relation(fields: [reasonId], references: [id], onDelete: Restrict)

  ladderVersion StrikeLadderVersion @relation(fields: [ladderVersionId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([issuedByUserId])
  @@index([reasonId])
  @@index([ladderVersionId])
  @@index([issuedAt])
  @@index([expiresAt])
  @@index([voidedAt])
}

/**
 * =========================================================
 * AUDIT LOG
 * =========================================================
 * Durable append-only audit history. Application code only
 * exposes create/read operations; no edit or delete route is
 * provided.
 */

model AuditEvent {
  id String @id @default(cuid())

  occurredAt DateTime @default(now())

  action     String
  success    Boolean
  statusCode Int

  actorUserId String?
  actorLabel  String?

  targetType String?
  targetId   String?

  ipAddress String?
  userAgent String?

  metadata Json?

  @@index([occurredAt])
  @@index([action])
  @@index([success])
  @@index([actorUserId])
  @@index([targetType, targetId])
}

// Ordinary creator channels only. Protected standing chats are deliberately
// separate work: they must never inherit ordinary role/person grants.
model ChatSetup {
  id String @id
  createdAt DateTime @default(now())
}

enum ClockBreakKind {
  SHORT_ONE
  SHORT_TWO
  MEAL
}

enum ClockBreakEndReason {
  MANUAL
  LIMIT
  CLOCK_OUT
  CORRECTION
}

model ClockSetup {
  id String @id
  createdAt DateTime @default(now())
}

model ClockShift {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  personName String
  startedAt DateTime @db.Timestamptz(0)
  endedAt DateTime? @db.Timestamptz(0)
  startDay String
  startWeek String
  startRequestId String @unique
  breaks ClockBreak[]
  alerts ClockAlert[]
  corrections ClockCorrection[]

  @@index([userId, startedAt])
  @@index([userId, startWeek])
}

model ClockBreak {
  id String @id @default(cuid())
  shiftId String
  shift ClockShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  kind ClockBreakKind
  startedAt DateTime @db.Timestamptz(0)
  endedAt DateTime? @db.Timestamptz(0)
  endReason ClockBreakEndReason?
  startRequestId String @unique

  @@unique([shiftId, kind])
  @@index([shiftId, startedAt])
}

enum ClockAlertKind {
  BREAK_REMINDER
  BREAK_LIMIT
  OPEN_SHIFT
}

// One durable event per threshold. Its audience is checked against CURRENT
// permissions/assignments on each read, never a stale recipient snapshot.
model ClockAlert {
  id String @id @default(cuid())
  eventKey String @unique
  shiftId String
  shift ClockShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  breakId String?
  breakKind ClockBreakKind?
  kind ClockAlertKind
  occurredAt DateTime @db.Timestamptz(0)
  recordedAt DateTime @db.Timestamptz(0)
  reads ClockAlertRead[]
  @@index([shiftId, kind])
  @@index([occurredAt, id])
}

model ClockAlertRead {
  alertId String
  userId String
  readAt DateTime @db.Timestamptz(0)
  alert ClockAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([alertId, userId])
  @@index([userId])
}

model ChatArea {
  modelId String @id
  archivedAt DateTime?
  createdAt DateTime @default(now())
  model AgencyModel @relation(fields: [modelId], references: [id], onDelete: Restrict)
  channels ChatChannel[]
  quarantines ChatQuarantine[]
}

// Current creator-local pause. Audit events and private notices retain each
// transition; lifting changes this state only, never assignments or grants.
model ChatQuarantine {
  id String @id @default(cuid())
  modelId String
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  area ChatArea @relation(fields: [modelId], references: [modelId], onDelete: Restrict)
  personName String
  active Boolean @default(false)
  version Int @default(0)
  reason String
  changedAt DateTime @default(now())
  changedById String
  changedByName String
  lastRequestId String @unique
  lastRequestHash String
  @@unique([modelId, userId])
  @@index([userId, active])
}

model ChatChannel {
  id String @id @default(cuid())
  modelId String
  key String
  name String
  sortOrder Int
  createdAt DateTime @default(now())
  area ChatArea @relation(fields: [modelId], references: [modelId], onDelete: Restrict)
  roleGrants ChatRoleGrant[]
  personGrants ChatPersonGrant[]
  messages ChatMessage[]
  @@unique([modelId, key])
  @@index([modelId, sortOrder])
}

model ChatRoleGrant {
  channelId String
  roleId String
  canView Boolean @default(false)
  canPost Boolean @default(false)
  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([channelId, roleId])
  @@index([roleId])
}

model ChatPersonGrant {
  channelId String
  // A grant belongs to this assignment episode. Unassignment deletes it;
  // returning to the creator cannot resurrect the previous named access.
  assignmentId String
  canView Boolean @default(false)
  canPost Boolean @default(false)
  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  assignment UserModelAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  @@id([channelId, assignmentId])
  @@index([assignmentId])
}

model ChatMessage {
  id String @id @default(cuid())
  channelId String?
  conversationId String?
  authorUserId String?
  authorName String
  clientNonce String
  systemEventKey String? @unique
  replyToId String?
  replyTo ChatMessage? @relation("ChatReply", fields: [replyToId], references: [id], onDelete: Restrict)
  replies ChatMessage[] @relation("ChatReply")
  pinnedAt DateTime?
  pinnedById String?
  pinnedByName String?
  pinVersion Int @default(0)
  pinnedBy User? @relation("ChatPinnedBy", fields: [pinnedById], references: [id], onDelete: SetNull)
  reactions ChatReaction[]
  deletedAt DateTime?
  deletedById String?
  deletedByName String?
  deletionReason String?
  deletedBy User? @relation("ChatDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  text String
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  channel ChatChannel? @relation(fields: [channelId], references: [id], onDelete: Restrict)
  conversation ChatStandingConversation? @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  author User? @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  @@index([replyToId])
  @@index([channelId, pinnedAt, id])
  @@index([conversationId, pinnedAt, id])
  @@index([channelId, deletedAt, id])
  @@index([conversationId, deletedAt, id])
  @@unique([channelId, authorUserId, clientNonce])
  @@unique([conversationId, authorUserId, clientNonce])
  @@index([channelId, createdAt, id])
  @@index([conversationId, createdAt, id])
}

enum ChatStandingKind {
  CREATOR
  STAFF
  ACCOUNTANT
  GENERAL_STAFF
}

// Protected conversations have NO role/person grant relation. Their membership
// is calculated from current assignments and explicit private-chat abilities.
model ChatStandingConversation {
  id String @id @default(cuid())
  kind ChatStandingKind
  modelId String?
  subjectUserId String?
  subjectName String
  // Immutable assignment-episode snapshot, deliberately not a foreign key.
  // Removing an assignment must retain the old conversation and its messages.
  assignmentId String?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  model AgencyModel? @relation(fields: [modelId], references: [id], onDelete: Restrict)
  subjectUser User? @relation(fields: [subjectUserId], references: [id], onDelete: SetNull)
  messages ChatMessage[]
  @@index([modelId, archivedAt])
  @@index([subjectUserId, kind, archivedAt])
}


enum ClockCorrectionKind {
  SHIFT_TIMES
  MISSING_SHIFT
}

enum ClockCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Before/after snapshots and names survive account deletion. A request never
// changes hours until an authorized, different person approves it atomically.
model ClockCorrection {
  id String @id @default(cuid())
  requestId String @unique
  userId String?
  subject User? @relation("ClockCorrectionSubject", fields: [userId], references: [id], onDelete: SetNull)
  personName String
  shiftId String?
  shift ClockShift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  kind ClockCorrectionKind
  status ClockCorrectionStatus @default(PENDING)
  reason String
  basisVersion String?
  beforeSnapshot Json?
  proposedSnapshot Json
  submittedAt DateTime @default(now()) @db.Timestamptz(0)
  reviewerId String?
  reviewer User? @relation("ClockCorrectionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerName String?
  reviewNote String?
  reviewedAt DateTime? @db.Timestamptz(0)

  @@index([userId, submittedAt, id])
  @@index([status, submittedAt, id])
  @@index([shiftId])
}

model ChatReaction {
  messageId String
  userId String
  emoji String
  createdAt DateTime @default(now())
  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([messageId, userId, emoji])
  @@index([userId])
}
