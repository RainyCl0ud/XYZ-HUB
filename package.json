{
  "name": "agency-operations-hub",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "staging:reset-test-data": "npm run staging:reset-test-data --workspace=backend",
    "staging:validate-test-data": "npm run test:staging-reset-data-plan --workspace=backend",
    "verify:static": "npm run build:backend && npm run build:frontend && npm run lint --workspace=frontend && npm audit",
    "verify:step1": "npm run verify:static && npm run test:step1 --workspace=backend"
  },
  "overrides": {
    "typescript": "6.0.3",
    "compression": "1.8.2",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2"
  }
}
